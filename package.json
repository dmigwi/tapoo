{
  "name": "tapoo",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build:frontend": "./scripts/build-frontend.sh",
    "typecheck:frontend": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.node.json --noEmit",
    "lint:frontend": "eslint frontend --max-warnings=0",
    "lint:frontend:fix": "eslint frontend --fix",
    "test:frontend": "vitest run",
    "coverage:frontend": "vitest run --coverage",
    "quality:frontend": "pnpm run typecheck:frontend && pnpm run lint:frontend && pnpm run test:frontend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "8.5.26",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
